# Copy to .env (make does this for you). Never commit .env.

# Uncomment and set, OR run `ant auth login` and leave this commented out
# (a set-but-empty key can shadow the login profile). A key exported in your shell wins.
# ANTHROPIC_API_KEY=

# Host-side runs (make test / make eval). The app container overrides this with the service name.
DATABASE_URL=postgresql://app:app@localhost:5434/app

# Tags every llm_calls row so several projects can share one database.
PROJECT_NAME=invoice-reconciliation

# Optional model overrides (defaults live in common/llm.py).
# LLM_MODEL_SMALL=claude-haiku-5-5
# LLM_MODEL_LARGE=claude-opus-5-5

# Which tier reads the invoices: small = Haiku (default), large = Opus.
# EXTRACT_TIER=small

# Offline demo only: EXTRACTOR=oracle replaces the model with the generator's ground truth
# plus deliberate misreads. Never set it when measuring anything.
# EXTRACTOR=oracle
